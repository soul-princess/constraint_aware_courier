    "\n",
    "for s in scenarios:\n",
    "    s_orders, s_riders, s_delay = disruption.apply_scenario(s, orders_raw, riders_raw)\n",
    "    scenario_results[scenario_labels[s]] = evaluation.compare_algorithms(s_orders, s_riders, s_delay)\n",
    "    print(f\"{scenario_labels[s]}: distance saved \"\n",
    "          f\"{scenario_results[scenario_labels[s]]['distance_saved_pct']:.1f}%\")\n"
   ]
